PORT=3000
NODE_ENV=development

# Database (MySQL via Prisma)
DATABASE_URL="mysql://root:password@localhost:3307/whatsapp_saas"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# App URL
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Meta (WhatsApp Cloud API / Embedded Signup): the Tech Provider app
META_FB_APP_ID=
META_FB_CONFIG_ID=           # Facebook Login for Business configuration ID (WhatsApp Embedded Signup)
META_APP_SECRET=             # App secret: verifies webhook signatures and exchanges the signup code
META_VERIFY_TOKEN=           # Any string; must match the verify token set in the Meta app's webhook config
# META_REGISTRATION_PIN=     # Optional: one 6-digit PIN for every number. Leave unset: each number gets its own derived PIN
# META_PIN_SECRET=           # Optional: secret used to derive those PINs (defaults to JWT_SECRET; never change it once numbers are registered)
# GRAPH_API_VERSION=v21.0
