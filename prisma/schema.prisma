generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Tenant {
  customFeatures   Json?             @map("custom_features")
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  passwordHash     String            @map("password_hash")
  companyName      String?           @map("company_name")
  plan             Plan              @default(FREE)
  isActive         Boolean           @default(true) @map("is_active")
  whatsappPhone    String?           @map("whatsapp_phone")
  sessionStatus    SessionStatus     @default(DISCONNECTED) @map("session_status")
  webhookUrl       String?           @map("webhook_url") @db.Text
  webhookEvents    Json?             @map("webhook_events")
  crmBaseUrl       String?           @map("crm_base_url") @db.Text
  crmApiToken      String?           @map("crm_api_token") @db.Text
  walletBalance    Float             @default(0) @map("wallet_balance")
  deductBalance    Boolean           @default(true) @map("deduct_balance")
  currency         String            @default("SAR")
  monthlyLimit     Int               @default(20) @map("monthly_limit")
  metaEnabled      Boolean           @default(false) @map("meta_enabled")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  apiKeys          ApiKey[]
  autoResponders   AutoResponder[]
  campaigns        Campaign[]
  invoices         Invoice[]
  messageLogs      MessageLog[]
  messageTemplates MessageTemplate[]
  usageRecords     UsageRecord[]
  channels         WhatsAppChannel[]
  chatThreads      ChatThread[]
  tickets          Ticket[]
  ticketCategories TicketCategory[]
  quickReplies     QuickReply[]
  subUsers         SubUser[]
  contactGroups    ContactGroup[]
  contacts         Contact[]
  walletTransactions WalletTransaction[]
  aiUsage          AiUsage[]
  adminSessions    AdminImpersonation[]
  couponRedemptions CouponRedemption[]
  referralCode     ReferralCode?
  referralsMade    Referral[]        @relation("ReferralReferrer")
  referredBy       Referral?         @relation("ReferralReferred")
  tasks            Task[]
  addons           AddonPurchase[]

  @@map("tenants")
}

model WhatsAppChannel {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  providerType String  @default("BAILEYS") @map("provider_type") // BAILEYS, META_CLOUD, WEBCHAT, MESSENGER, INSTAGRAM, TIKTOK (channels/channel.kinds.js)
  // The channel's own id at its platform: Facebook Page id (MESSENGER), Instagram account id (INSTAGRAM),
  // the account's open_id for our app (TIKTOK)
  externalId   String? @map("external_id")
  phoneNumber  String? @map("phone_number")
  status       String  @default("DISCONNECTED")

  // Meta Specific fields
  metaPhoneNumberId  String? @map("meta_phone_number_id")
  metaWabaId         String? @map("meta_waba_id")
  metaAccessToken    String? @map("meta_access_token") @db.Text
  metaAppSecret      String? @map("meta_app_secret") @db.Text // Required for HMAC validation
  // Channels whose access token expires (TikTok: one day): renewed with the refresh token before use
  refreshToken       String?   @map("refresh_token") @db.Text
  tokenExpiresAt     DateTime? @map("token_expires_at")
  // Human-readable label for this channel (e.g. "Support Line", "+966500000000")
  name               String? @default("") @map("name")
  displayPhoneNumber String? @map("display_phone_number") // from Meta Business Manager
  autoCreateTickets  Boolean @default(true) @map("auto_create_tickets") // This number opens tickets for customer messages (Ticket settings)

  // Coexistence: the number was connected from the customer's WhatsApp Business app and keeps working there
  isCoexistence     Boolean   @default(false) @map("is_coexistence")
  coexOnboardedAt   DateTime? @map("coex_onboarded_at") // start of Meta's 24h window for the one-time syncs
  coexHistoryMonths Int?      @map("coex_history_months") // old chats to keep: 0 (none), 1, 3 or 6 months
  coexSync          Json?     @map("coex_sync") // { state, stateReason, contacts: {...}, history: {...} }

  // Channel-kind settings. Website widget (providerType WEBCHAT): { enabled, title, welcome, color, position,
  // language, askName, askPhone, whatsappNumber, allowedDomains } — see webchat/webchat.settings.js
  settings Json? @map("settings")
  // Monthly fee of channels sold per channel (website widget, Instagram, Messenger), paid from the wallet
  // (channels/channel.billing.js): null state = free, ACTIVE = paid until paidUntil, UNPAID = stopped
  paidUntil    DateTime? @map("paid_until")
  billingState String?   @map("billing_state") @db.VarChar(12)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  messageLogs    MessageLog[]
  chatThreads    ChatThread[]
  tickets        Ticket[]
  autoResponders AutoResponder[]
  subUsers       SubUser[]

  @@index([tenantId], map: "whatsapp_channels_tenant_id_fkey")
  @@index([providerType, externalId], map: "whatsapp_channels_provider_external_idx")
  @@index([metaPhoneNumberId], map: "whatsapp_channels_meta_phone_number_id_idx") // every Meta webhook finds its number by this
  @@map("whatsapp_channels")
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  keyHash    String    @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  label      String?
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "api_keys_tenant_id_fkey")
  @@map("api_keys")
}

model MessageLog {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  channelId      String?          @map("channel_id")
  phone          String
  messageType    MessageType      @default(OTP) @map("message_type")
  status         MessageStatus    @default(QUEUED)
  errorMessage   String?          @map("error_message") @db.Text
  // Meta Cloud API specific: wamid returned from Meta API on send
  metaMessageId  String?          @map("meta_message_id") @db.VarChar(200)
  // Tracks Meta delivery lifecycle: sent → delivered → read → failed
  deliveryStatus String?          @default("pending") @map("delivery_status")
  createdAt      DateTime         @default(now()) @map("created_at")
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel        WhatsAppChannel? @relation(fields: [channelId], references: [id])

  @@index([tenantId], map: "message_logs_tenant_id_fkey")
  @@index([channelId], map: "message_logs_channel_id_fkey")
  @@index([metaMessageId], map: "message_logs_meta_message_id_idx")
  @@map("message_logs")
}

model UsageRecord {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  month          DateTime @db.Date
  messagesSent   Int      @default(0) @map("messages_sent")
  messagesFailed Int      @default(0) @map("messages_failed")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
  @@map("usage_records")
}

model MessageTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  mediaMime String?  @map("media_mime")
  mediaPath String?  @map("media_path")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "message_templates_tenant_id_fkey")
  @@map("message_templates")
}

model Campaign {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  channelId       String?             @map("channel_id")
  name            String
  message         String?             @db.Text
  status          String              @default("PENDING")
  campaignType    String              @default("BAILEYS") @map("campaign_type") // BAILEYS or META
  metaCategory    String?             @map("meta_category") // MARKETING, UTILITY, AUTHENTICATION
  headerMedia     Json?               @map("header_media") // META: { type, id | link, filename } of a media-header template
  createdAt       DateTime            @default(now()) @map("created_at")
  mediaMime       String?             @map("media_mime")
  mediaPath       String?             @map("media_path")
  templateId      String?             @map("template_id")
  buttons         String?             @map("buttons") @db.Text
  interactiveType String?             @map("interactive_type")
  startDate       DateTime?           @map("start_date")
  endDate         DateTime?           @map("end_date")
  totalCost       Float               @default(0) @map("total_cost")
  totalMessages   Int                 @default(0) @map("total_messages")
  launchedAt      DateTime?           @map("launched_at") // META: launched (sent in waves by campaign.dispatcher.js)
  completedAt     DateTime?           @map("completed_at")
  interactions    ButtonInteraction[]
  targets         CampaignTarget[]
  autoResponders  AutoResponder[]
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel         WhatsAppChannel?    @relation(fields: [channelId], references: [id])

  @@index([tenantId], map: "campaigns_tenant_id_fkey")
  @@index([channelId], map: "campaigns_channel_id_fkey")
  @@index([status], map: "campaigns_status_idx")
  @@map("campaigns")
}

model CampaignTarget {
  id           String              @id @default(uuid())
  campaignId   String              @map("campaign_id")
  phone        String
  status       String              @default("PENDING") // PENDING → QUEUED (META, in the send queue) → SENT / FAILED; CANCELLED
  error        String?             @db.Text
  variables    String?             @db.Text // Store JSON array of variables
  queuedAt     DateTime?           @map("queued_at")
  sentAt       DateTime?           @map("sent_at")
  interactions ButtonInteraction[]
  campaign     Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId], map: "campaign_targets_campaign_id_fkey")
  @@index([campaignId, status], map: "campaign_targets_campaign_status_idx")
  @@index([phone], map: "campaign_targets_phone_idx") // a customer's reply is matched to the campaign that messaged them
  @@map("campaign_targets")
}

model ButtonInteraction {
  id               String          @id @default(uuid())
  campaignId       String          @map("campaign_id")
  campaignTargetId String?         @map("campaign_target_id")
  tenantId         String          @map("tenant_id")
  phone            String
  buttonId         String          @map("button_id")
  buttonText       String          @map("button_text") @db.Text
  interactionType  String          @default("BUTTON") @map("interaction_type")
  createdAt        DateTime        @default(now()) @map("created_at")
  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignTarget   CampaignTarget? @relation(fields: [campaignTargetId], references: [id])

  @@index([campaignId], map: "button_interactions_campaign_id_fkey")
  @@index([campaignTargetId], map: "button_interactions_campaign_target_id_fkey")
  @@map("button_interactions")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber Int      @unique @default(autoincrement()) @map("invoice_number")
  tenantId      String   @map("tenant_id")
  amount        String
  description   String   @db.Text
  status        String   @default("UNPAID")
  createdAt     DateTime @default(now()) @map("created_at")
  billingCycle  String   @default("Monthly") @map("billing_cycle")
  dueDate       DateTime @default(now()) @map("due_date")
  items         Json?
  taxRate       Float?   @default(15.0) @map("tax_rate")
  taxAmount     String?  @map("tax_amount")
  buyerDetails  Json?    @map("buyer_details")
  sellerDetails Json?    @map("seller_details")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "invoices_tenant_id_fkey")
  @@map("invoices")
}

model AutoResponder {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  keyword          String           @db.Text
  matchType        String           @default("EXACT") @map("match_type")
  // responseType: TEXT | IMAGE | VIDEO | DOCUMENT | QR_CODE | META_TEMPLATE
  responseType     String           @default("TEXT") @map("response_type")
  message          String?          @db.Text
  mediaPath        String?          @map("media_path") @db.Text
  mediaUrl         String?          @map("media_url") @db.Text // public URL for Meta media
  mediaMime        String?          @map("media_mime")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  lat              Float?
  lng              Float?
  locationAddress  String?          @map("location_address")
  locationName     String?          @map("location_name")
  endDate          DateTime?        @map("end_date")
  startDate        DateTime?        @map("start_date")
  campaignId       String?          @map("campaign_id")
  // Meta-specific: link rule to a specific Meta channel
  channelId        String?          @map("channel_id")
  // Also answers on every Live Chat channel: other WhatsApp numbers, website widget, Instagram, Messenger
  allChannels      Boolean          @default(false) @map("all_channels")
  // For META_TEMPLATE response type
  metaTemplateName String?          @map("meta_template_name")
  metaTemplateLang String?          @default("ar") @map("meta_template_lang")
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign         Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel          WhatsAppChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "auto_responders_tenant_id_fkey")
  @@index([campaignId], map: "auto_responders_campaign_id_fkey")
  @@index([channelId], map: "auto_responders_channel_id_fkey")
  @@map("auto_responders")
}

model PlanSetting {
  featureFlags Json?    @map("feature_flags")
  id           String   @id @default(uuid())
  planCode     Plan     @unique @map("plan_code")
  name         String
  nameAr       String?  @map("name_ar")
  nameEn       String?  @map("name_en")
  price        Float
  limit        Int
  features     String   @db.Text
  featuresAr   String?  @map("features_ar") @db.Text
  featuresEn   String?  @map("features_en") @db.Text
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  isPopular    Boolean  @default(false) @map("is_popular")
  buttonTextAr String?  @map("button_text_ar")
  buttonTextEn String?  @map("button_text_en")
  maxUsers     Int?     @map("max_users") // team members included in the plan; null = no limit
  maxNumbers   Int?     @map("max_numbers") // official (Meta) numbers included in the plan; null = no limit
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("plan_settings")
}

enum Plan {
  FREE
  STARTER
  ADVANCED
  PRO
  ENTERPRISE
}

enum SessionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

enum MessageType {
  OTP
  CUSTOM
  INTERACTIVE
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model ChatThread {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  channelId     String   @map("channel_id")
  contactPhone  String   @map("contact_phone")
  contactName   String?  @map("contact_name")
  crmClientId   String?  @map("crm_client_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  unreadCount   Int      @default(0) @map("unread_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  messages ChatMessage[]
  // tickets  Ticket[]
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channelId, contactPhone])
  @@index([tenantId], map: "chat_threads_tenant_id_fkey")
  @@map("chat_threads")
}

model ChatMessage {
  id            String   @id @default(uuid())
  threadId      String   @map("thread_id")
  direction     String // "INBOUND" or "OUTBOUND"
  type          String   @default("TEXT") // "TEXT", "IMAGE", "VIDEO", "DOCUMENT", "AUDIO"
  content       String?  @db.Text
  hasMedia      Boolean  @default(false) @map("has_media")
  mediaUrl      String?  @map("media_url") @db.Text
  mediaMime     String?  @map("media_mime")
  status        String? // "SENT", "DELIVERED", "READ", "FAILED" for outbound
  metaMessageId String?  @map("meta_message_id")
  ticketId      String?  @map("ticket_id")
  createdAt     DateTime @default(now()) @map("created_at")

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  ticket Ticket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([threadId], map: "chat_messages_thread_id_fkey")
  @@index([ticketId], map: "chat_messages_ticket_id_fkey")
  @@map("chat_messages")
}

model Ticket {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  channelId       String   @map("channel_id")
  threadId        String   @map("thread_id")
  ticketNumber    String   @map("ticket_number")
  status          String   @default("OPEN") // OPEN, PENDING, RESOLVED, CLOSED
  priority        String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedToId    String?  @map("assigned_to_id")
  subject         String?  @db.Text
  categoryId      String?  @map("category_id")
  rating          Int?     // 1 to 5
  summary         String?  @db.Text // AI generated summary of the conversation
  crmTicketId     String?  @map("crm_ticket_id")
  crmClientId     String?  @map("crm_client_id")
  crmContactId    String?  @map("crm_contact_id")
  resolvedAt      DateTime? @map("resolved_at")
  firstResponseAt DateTime? @map("first_response_at") // first reply a person wrote to the customer
  // When the ticket was ready for a person: at creation, or when a WhatsApp flow handed the chat over
  readyAt         DateTime? @map("ready_at")
  firstAssignedAt DateTime? @map("first_assigned_at") // pick-up time = firstAssignedAt - readyAt
  // How it was first taken: OPEN (opened the chat), REPLY (first reply), ROUTING (team rules),
  // MANUAL (someone assigned it), SELF ("take" button), FLOW (a flow's hand-off to one agent)
  assignedVia     String?   @map("assigned_via") @db.VarChar(10)
  // First time a team member looked at it after it was ready (opened the chat, or replied), whatever the
  // "take on open / on first reply" setting: opening time = firstOpenedAt - readyAt
  firstOpenedAt   DateTime? @map("first_opened_at")
  firstOpenedById String?   @map("first_opened_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  WhatsAppChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // Removed relation because ChatThread is now in MongoDB
  // thread   ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  assignee SubUser?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  category TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  messages ChatMessage[]

  @@index([tenantId], map: "tickets_tenant_id_fkey")
  @@index([threadId], map: "tickets_thread_id_fkey")
  @@index([assignedToId], map: "tickets_assigned_to_id_fkey")
  @@index([categoryId], map: "tickets_category_id_fkey")
  @@unique([tenantId, ticketNumber], map: "tickets_tenant_id_ticket_number_key")
  @@map("tickets")
}

model TicketCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([tenantId], map: "ticket_categories_tenant_id_fkey")
  @@map("ticket_categories")
}

model QuickReply {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  shortcut  String   // e.g. "welcome", "pricing"
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "quick_replies_tenant_id_fkey")
  @@map("quick_replies")
}

model SystemSetting {
  id        String   @id @default("GLOBAL")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ══════════════════════════════════════════
// Sub-User Management (Users under a Tenant)
// ══════════════════════════════════════════

model SubUser {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  channelId    String?     @map("channel_id") // رقم الواتساب المخصص لهذا المستخدم
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  // الدور: OWNER (محجوز للمالك) | ADMIN | MANAGER | AGENT
  role         SubUserRole @default(AGENT)
  // صلاحيات مخصصة تُعيد تعريف الدور الافتراضي
  permissions  Json? // { "can_send_message": true, "can_view_campaigns": false, ... }
  isActive     Boolean     @default(true) @map("is_active")
  lastLoginAt  DateTime?   @map("last_login_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel WhatsAppChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  assignedTickets Ticket[]

  @@index([tenantId], map: "sub_users_tenant_id_fkey")
  @@index([channelId], map: "sub_users_channel_id_fkey")
  @@map("sub_users")
}

enum SubUserRole {
  ADMIN
  MANAGER
  AGENT
}

// ══════════════════════════════════════════
// Contacts Management
// ══════════════════════════════════════════

model ContactGroup {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  contacts Contact[]
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "contact_groups_tenant_id_fkey")
  @@map("contact_groups")
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  groupId   String?  @map("group_id")
  name      String
  phone     String
  email     String?
  metadata  Json? // For extra fields (variables like var1, var2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  ContactGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([tenantId], map: "contacts_tenant_id_fkey")
  @@index([groupId], map: "contacts_group_id_fkey")
  @@map("contacts")
}

// ══════════════════════════════════════════
// Wallet ledger: every movement of Tenant.walletBalance
// ══════════════════════════════════════════

model WalletTransaction {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  // TOP_UP | ADMIN_DEDUCTION | ADMIN_SET | CAMPAIGN_CHARGE | CHANNEL_FEE | REFUND | REFERRAL_REWARD
  type          String
  // Signed: positive adds money to the wallet, negative spends it
  amount        Float
  balanceAfter  Float    @map("balance_after")
  currency      String   @default("SAR")
  description   String?  @db.Text
  // What the movement belongs to, e.g. CAMPAIGN + the campaign id
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  // The channel it was for (one wallet, spend shown per channel): WHATSAPP | WHATSAPP_QR | WEBCHAT | …
  channelKind   String?  @map("channel_kind") @db.VarChar(20)
  channelId     String?  @map("channel_id")
  // Admin id, or "SYSTEM"
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt], map: "wallet_transactions_tenant_id_created_at_idx")
  @@index([referenceType, referenceId], map: "wallet_transactions_reference_idx")
  @@map("wallet_transactions")
}

// One Gemini request: who made it, for which feature, and how many tokens it used (Google bills tokens).
// sharedKey = it ran on the platform key (GEMINI_API_KEY), so the platform pays for it.
model AiUsage {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  feature      String   @db.VarChar(40)
  model        String   @db.VarChar(80)
  sharedKey    Boolean  @default(false) @map("shared_key")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens") // the answer plus Gemini's thinking
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt], map: "ai_usage_tenant_id_created_at_idx")
  @@index([createdAt], map: "ai_usage_created_at_idx")
  @@map("ai_usage")
}

// An admin working inside a customer's dashboard ("log in as customer"): who, when, until when, and every
// change made during the session. The customer is not notified.
model AdminImpersonation {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  adminEmail String    @map("admin_email") @db.VarChar(191)
  ip         String?   @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  startedAt  DateTime  @default(now()) @map("started_at")
  expiresAt  DateTime  @map("expires_at")
  endedAt    DateTime? @map("ended_at")
  actions    Json? // [{ at, method, path, status }] of the requests that changed something

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt], map: "admin_impersonations_tenant_id_started_at_idx")
  @@map("admin_impersonations")
}

// Discount codes for subscription invoices (no payment gateway: the customer applies the code to an unpaid
// invoice, which gets a discount line and its VAT recalculated). value: percent (1-100) or SAR before VAT.
model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique @db.VarChar(40)
  type             String    @default("PERCENT") @db.VarChar(10) // PERCENT | FIXED
  value            Float
  maxUses          Int?      @map("max_uses") // null = no limit
  usedCount        Int       @default(0) @map("used_count")
  expiresAt        DateTime? @map("expires_at")
  plans            Json? // ["PRO", "STARTER"]; null = every plan
  firstInvoiceOnly Boolean   @default(false) @map("first_invoice_only")
  isActive         Boolean   @default(true) @map("is_active")
  note             String?   @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

// One use of a coupon: on one invoice, once per account
model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String   @map("coupon_id")
  tenantId  String   @map("tenant_id")
  invoiceId String   @unique @map("invoice_id")
  discount  Float // before VAT
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([couponId, tenantId], map: "coupon_redemptions_coupon_tenant_key")
  @@index([tenantId], map: "coupon_redemptions_tenant_id_idx")
  @@map("coupon_redemptions")
}

// An account's invite code (https://…/register?ref=CODE), created the first time it opens its invite card
model ReferralCode {
  tenantId  String   @id @map("tenant_id")
  code      String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("referral_codes")
}

// Who invited whom. PENDING until the invited account's first invoice is paid, then the inviter's wallet is
// credited with the reward set by the admin (REWARDED).
model Referral {
  id           String    @id @default(uuid())
  referrerId   String    @map("referrer_id")
  referredId   String    @unique @map("referred_id")
  status       String    @default("PENDING") @db.VarChar(12) // PENDING | REWARDED
  rewardAmount Float?    @map("reward_amount")
  rewardedAt   DateTime? @map("rewarded_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  referrer Tenant @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Tenant @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId], map: "referrals_referrer_id_idx")
  @@map("referrals")
}

// A follow-up for the team ("call back tomorrow", "send the price quote"), with a due time and a person in
// charge, optionally on a conversation. assigneeId / createdBy: 'owner' or a sub-user id.
model Task {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  title        String    @db.VarChar(200)
  notes        String?   @db.Text
  status       String    @default("OPEN") @db.VarChar(10) // OPEN | DONE
  dueAt        DateTime? @map("due_at")
  assigneeId   String?   @map("assignee_id") @db.VarChar(64)
  createdBy    String    @map("created_by") @db.VarChar(64)
  threadId     String?   @map("thread_id") @db.VarChar(64) // Live Chat conversation (Mongo id)
  contactName  String?   @map("contact_name") @db.VarChar(191)
  contactPhone String?   @map("contact_phone") @db.VarChar(32)
  completedAt  DateTime? @map("completed_at")
  completedBy  String?   @map("completed_by") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueAt], map: "tasks_tenant_status_due_idx")
  @@index([tenantId, assigneeId], map: "tasks_tenant_assignee_idx")
  @@index([threadId], map: "tasks_thread_id_idx")
  @@map("tasks")
}

// Extra team members / numbers on top of the plan. Requested by the customer → an invoice for the rest of the
// month (+ VAT) → ACTIVE once the invoice is paid. Active add-ons stay until an admin cancels them; the monthly
// invoice the admin issues should include them.
model AddonPurchase {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  kind       String    @db.VarChar(10) // USERS | NUMBERS
  quantity   Int
  unitPrice  Float     @map("unit_price") // SAR per month before VAT, at the time of the request
  invoiceId  String?   @unique @map("invoice_id")
  status     String    @default("PENDING") @db.VarChar(10) // PENDING | ACTIVE | CANCELLED
  activatedAt DateTime? @map("activated_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], map: "addon_purchases_tenant_status_idx")
  @@map("addon_purchases")
}
